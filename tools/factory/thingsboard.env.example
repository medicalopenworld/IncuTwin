# Acceso a la API REST de ThingsBoard (tenant Medical Open World) para las herramientas tb/.
# Copia este fichero a tools/factory/secrets/thingsboard.env (directorio en .gitignore) y rellenalo.
# NUNCA lo subas ni pegues su contenido en un chat.

TB_URL=https://mon.medicalopenworld.org

# Opcion A (preferida): API key de un usuario administrador del tenant
# (ThingsBoard 4.x: tu perfil -> Security -> API keys). Se envia como "X-Authorization: ApiKey <key>".
TB_API_KEY=RELLENAR

# Opcion B: si no hay API key, usuario y contrasena de un administrador de tenant; las
# herramientas piden un JWT con /api/auth/login y no lo guardan en ningun sitio.
TB_USER=
TB_PASS=
