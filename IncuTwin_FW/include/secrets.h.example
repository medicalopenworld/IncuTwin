#pragma once
/* Copia este archivo a include/secrets.h (ignorado por git) y rellena las
 * claves del device profile "IncuTwin" en ThingsBoard:
 *   Profiles -> Device profiles -> IncuTwin -> Device provisioning
 * Nunca subas include/secrets.h al repositorio. Si una clave se filtra,
 * regenérala en ese mismo panel de ThingsBoard: los paneles ya
 * provisionados no se ven afectados (guardan su propio access token).
 */
#define TB_PROVISION_KEY "pega-aqui-la-provision-key"
#define TB_PROVISION_SECRET "pega-aqui-el-provision-secret"
